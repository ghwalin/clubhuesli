# Apache: serve existing files directly, send every /api request to the API
# front controller and everything else to the single-page application.
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^api/?(.*)$ api/index.php [QSA,L]
RewriteRule ^ index.html [L]

# Do not list directories.
Options -Indexes

# Static files change with every release: let the browser revalidate (ETag) instead of
# guessing a lifetime, otherwise an old view can end up next to a new script.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
