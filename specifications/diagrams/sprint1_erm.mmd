erDiagram
    PERSON ||--o| NATURAL_PERSON : "ist"
    PERSON ||--o| LEGAL_PERSON : "ist"
    NATURAL_PERSON ||--o| TEAM_MEMBER : "ist"
    TEAM_MEMBER ||--o{ GUARDIANSHIP : "Kind"
    NATURAL_PERSON ||--o{ GUARDIANSHIP : "Erziehungsberechtigte"
    PERSON ||--o{ MEMBERSHIP : "ist zugeordnet"
    CLUB_GROUP ||--o{ MEMBERSHIP : "hat Mitglieder"
    SEASON ||--o{ MEMBERSHIP : "gilt für"
    CLUB_GROUP ||--o{ GROUP_HIERARCHY : "Obergruppe"
    CLUB_GROUP ||--o{ GROUP_HIERARCHY : "Untergruppe"

    PERSON {
        int id PK
        string person_type "NATURAL | LEGAL"
        string member_type
        string email "nicht eindeutig"
        string phone
        string street
        string house_number
        string address_addition
        string zip
        string city
        string country "ISO, Standard CH"
        text note
    }
    NATURAL_PERSON {
        int person_id PK, FK
        string first_name
        string last_name
        date birth_date
    }
    TEAM_MEMBER {
        int person_id PK, FK
        string ahv_number
        string js_number
        boolean photo_consent
    }
    LEGAL_PERSON {
        int person_id PK, FK
        string name
        string contact_first_name
        string contact_last_name
        text support
    }
    GUARDIANSHIP {
        int child_id PK, FK
        int guardian_id PK, FK
    }
    SEASON {
        int id PK
        string name "eindeutig, z.B. 2026/27"
        date start_date
        date end_date
    }
    CLUB_GROUP {
        int id PK
        string name "eindeutig"
        string group_type "TEAM | FUNCTIONARY | OTHER"
        string status "ACTIVE | INACTIVE"
    }
    GROUP_HIERARCHY {
        int parent_id PK, FK
        int child_id PK, FK
    }
    MEMBERSHIP {
        int id PK
        int group_id FK
        int person_id FK
        int season_id FK
        string role "PLAYER | COACH | MEMBER"
        string function "Freitext, optional"
        int shirt_number "optional, nur PLAYER"
        date exit_date "optional, innerhalb der Saison"
    }
